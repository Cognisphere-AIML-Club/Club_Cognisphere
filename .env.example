# Firebase Web App Public Configuration
# Get these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Club Contact Details (Kept private, never committed to git)
# Supports plaintext (e.g. +91 98765 43210) or base64-encoded to protect bundle chunks from regex scrapers (e.g. btoa('+91 9876543210'))
VITE_CLUB_CONTACT_PHONE=your_phone_number_here

# Club Gmail Apps Script Executable API Secret
# Keep without VITE_ prefix so Vite never bundles this secret into public dist/ JavaScript!
# Paste this value into Admin -> Setup Auto-Send -> API Secret Key (stored in Admin-only Firestore privateSettings/mailer) & Apps Script.
MAILER_API_SECRET=replace_with_32_plus_char_random_secret_key


